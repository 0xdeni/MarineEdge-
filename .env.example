# Copy to .env. Never commit .env. On a server, deploy/install.sh writes it for you.
VVT_PROVIDER=aisstream         # aisstream (free feed, recorded on this server) | datalastic | kpler. The admin can change it in the app.
VVT_ALLOW_MOCK=                # 1 only on a development machine: allows the generated demo fleet (a server never shows it)
DATALASTIC_API_KEY=            # optional fallback; normally pasted in the app (Profile › Data sources)
KPLER_API_KEY=
DATABASE_URL=                  # postgresql://vvt:vvt@localhost:5432/vvt  (empty = in-memory store, development only)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=INFO
VVT_REPORT_DIR=/tmp/marineedge-reports
API_TOKENS=                    # name:token[:admin], comma separated, for scripts. The admin token is also the server admin password that creates the first account.
DOMAIN=                        # the server's public name; links in emails and the push sender use https://DOMAIN
PUBLIC_URL=                    # optional: overrides https://DOMAIN in emailed links
UK_SANCTIONS_CSV_URL=          # empty = the FCDO UK Sanctions List CSV (fixed address); "off" skips the UK list
RCLONE_REMOTE=                 # optional off-site backup target for deploy/backup.sh
VAPID_PUBLIC_KEY=              # web push: python -m app.push keygen (install.sh does it)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                 # empty = https://DOMAIN
PUSH_MIN_SEVERITY=high         # server default; each person can choose High and Medium in Profile › Notifications
OPENSANCTIONS=0                # 1 = include the OpenSanctions maritime file in the daily refresh (licence!)
POSTGIS_IMAGE=                 # leave empty on amd64; Arm servers: imresamu/postgis:16-3.4-bookworm (install.sh sets it)
API_WORKERS=2                  # 1 on 1–2 GB machines (install.sh sets it)
PG_SHARED_BUFFERS=            # Postgres cache; install.sh: a quarter of RAM, max 4GB (default 128MB)
PG_EFFECTIVE_CACHE=           # install.sh: half of RAM (default 512MB)
