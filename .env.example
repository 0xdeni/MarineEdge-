# Copy to .env. Never commit .env.
VVT_PROVIDER=mock              # mock | datalastic | kpler
DATALASTIC_API_KEY=
KPLER_API_KEY=
DATABASE_URL=                  # postgresql://vvt:vvt@localhost:5432/vvt  (empty = in-memory cache, mock mode)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=INFO
VVT_REPORT_DIR=/tmp/marineedge-reports
API_TOKENS=                    # name:token pairs, comma separated; empty = open API (dev only). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
UK_SANCTIONS_CSV_URL=          # current CSV link from https://www.gov.uk/government/publications/the-uk-sanctions-list
RCLONE_REMOTE=                 # optional off-site backup target for deploy/backup.sh
VAPID_PUBLIC_KEY=              # web push: python -m app.push keygen (needs pip install pywebpush)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@yourcompany.com
PUSH_MIN_SEVERITY=high         # high | medium
OPENSANCTIONS=0                # 1 = include the OpenSanctions maritime file in the daily refresh (licence!)
POSTGIS_IMAGE=                 # leave empty on amd64; Arm servers: imresamu/postgis:16-3.4-bookworm (install.sh sets it)
API_WORKERS=2                  # 1 on 1–2 GB machines (install.sh sets it)
PG_SHARED_BUFFERS=            # Postgres cache; install.sh: a quarter of RAM, max 4GB (default 128MB)
PG_EFFECTIVE_CACHE=           # install.sh: half of RAM (default 512MB)
